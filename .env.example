# =============================================================================
# AI-POWERED HR RECRUITMENT SYSTEM - ENVIRONMENT CONFIGURATION (EXAMPLE)
# =============================================================================
# Copy this file to .env and fill in your actual API keys
# Keep .env secure and never commit it to version control!

# =============================================================================
# REQUIRED API KEYS
# =============================================================================

# Google Gemini API Key (REQUIRED for core AI functionality)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# OPTIONAL API KEYS (Enhance functionality but not required)
# =============================================================================

# GitHub API Token (Enhances repository analysis and code evaluation)
# Get from: https://github.com/settings/tokens
# Permissions needed: public_repo, read:user, read:org
GITHUB_API_TOKEN=your_github_token_here

# Google APIs (Enable web search and Google Docs access)
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key_here

# Google Custom Search Engine ID (Required for web search functionality)
# Create at: https://cse.google.com/cse/
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Google Service Account Credentials (For Google Docs/Drive access)
# Create service account at: https://console.cloud.google.com/iam-admin/serviceaccounts
# Download JSON file and provide the full path here
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# LinkedIn API Key (Enhances LinkedIn profile analysis)
# Apply for access at: https://developer.linkedin.com/
# Note: LinkedIn API access is restricted and requires approval
LINKEDIN_API_KEY=your_linkedin_api_key_here

# =============================================================================
# ADDITIONAL PLATFORM APIs (Optional - for enhanced research)
# =============================================================================

# Kaggle API (For Kaggle profile and competition analysis)
# Get from: https://www.kaggle.com/settings/account (API section)
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Twitter API (For professional Twitter analysis)
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret

# Stack Overflow API (No key required for basic usage, but provides higher rate limits)
# Register at: https://stackapps.com/apps/oauth/register
STACKOVERFLOW_API_KEY=your_stackoverflow_api_key

# =============================================================================
# SYSTEM CONFIGURATION
# =============================================================================

# AI Model Configuration
# Available models (May 2026 - from fastest/cheapest to most capable):
# STABLE (Recommended for production):
#   - gemini-3.5-flash (BEST: Latest stable, most intelligent, great performance)
#   - gemini-3.1-flash-lite (BUDGET: Stable, fraction of cost, excellent value)
#   - gemini-2.5-flash (Current gen, proven, reliable)
#   - gemini-2.5-flash-lite (Fastest, most budget-friendly)
#   - gemini-2.5-pro (Most advanced for complex tasks)
# PREVIEW (Latest features, may change):
#   - gemini-3-flash-preview (Frontier-class performance)
#   - gemini-3.1-pro-preview (Advanced intelligence)
# NOTE: gemini-2.0-* models are DEPRECATED and will be shut down
AI_MODEL=gemini-3.5-flash

# Rate Limiting (requests per minute)
RATE_LIMIT_GITHUB=30
RATE_LIMIT_GOOGLE=100
RATE_LIMIT_GENERAL=60

# Timeout Settings (seconds)
REQUEST_TIMEOUT=30
RESEARCH_TIMEOUT=300

# =============================================================================
# OUTPUT CONFIGURATION
# =============================================================================

# Output directory for reports and results
OUTPUT_DIR=output

# Report format (json, pdf, html)
REPORT_FORMAT=json

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Research depth (quick, medium, thorough)
RESEARCH_DEPTH=medium

# =============================================================================
# EXAMPLE VALUES AND INSTRUCTIONS
# =============================================================================

# EXAMPLE GEMINI_API_KEY FORMAT:
# GEMINI_API_KEY=AIzaSyAbc123Def456Ghi789Jkl012Mno345Pqr678Stu

# EXAMPLE GITHUB_API_TOKEN FORMAT:
# GITHUB_API_TOKEN=ghp_abc123def456ghi789jkl012mno345pqr678stu

# EXAMPLE GOOGLE_API_KEY FORMAT:
# GOOGLE_API_KEY=AIzaSyAbc123Def456Ghi789Jkl012Mno345Pqr678Stu

# EXAMPLE GOOGLE_SEARCH_ENGINE_ID FORMAT:
# GOOGLE_SEARCH_ENGINE_ID=abc123def456ghi789:jkl012mno345pqr

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================

# 1. GEMINI API KEY (REQUIRED):
#    - Go to https://makersuite.google.com/app/apikey
#    - Create a new API key
#    - Copy the key and paste it above

# 2. GITHUB API TOKEN (OPTIONAL BUT RECOMMENDED):
#    - Go to https://github.com/settings/tokens
#    - Click "Generate new token (classic)"
#    - Select scopes: public_repo, read:user, read:org
#    - Generate and copy the token

# 3. GOOGLE API SETUP (OPTIONAL):
#    - Go to https://console.cloud.google.com/
#    - Create a new project or select existing one
#    - Enable "Custom Search API"
#    - Create credentials (API Key)
#    - Set up Custom Search Engine at https://cse.google.com/cse/

# 4. GOOGLE SERVICE ACCOUNT (FOR GOOGLE DOCS):
#    - Go to https://console.cloud.google.com/iam-admin/serviceaccounts
#    - Create service account
#    - Download JSON credentials file
#    - Put the full path to the file in GOOGLE_APPLICATION_CREDENTIALS

# 5. LINKEDIN API (OPTIONAL - REQUIRES APPROVAL):
#    - Apply at https://developer.linkedin.com/
#    - Note: LinkedIn API access is restricted and requires business justification

# =============================================================================
# TROUBLESHOOTING
# =============================================================================

# If you encounter issues:

# 1. API KEY NOT WORKING:
#    - Check for extra spaces or quotes
#    - Ensure the key is active and has billing set up (if required)
#    - Verify the key has necessary permissions

# 2. GOOGLE DOCS ACCESS ISSUES:
#    - Ensure service account has access to the documents
#    - Check that the JSON file path is correct
#    - Verify the service account has Drive API access

# 3. RATE LIMITING ISSUES:
#    - Reduce the number of candidates processed at once
#    - Increase the rate limiting values above
#    - Add delays between requests

# 4. GITHUB API ISSUES:
#    - Ensure token has the right scopes
#    - Check if the token is expired
#    - Verify the repositories are public

# =============================================================================
# SECURITY NOTES
# =============================================================================

# IMPORTANT SECURITY REMINDERS:
# - Never commit this .env file to version control
# - Keep your API keys secure and rotate them regularly
# - Use environment-specific .env files for different deployments
# - Monitor your API usage to detect any unauthorized access
# - Follow the principle of least privilege for API permissions

# The .gitignore file is configured to exclude .env files.
# Make sure .env is listed in your .gitignore!

# =============================================================================
# COST ESTIMATION
# =============================================================================

# ESTIMATED COSTS PER 100 CANDIDATES (May 2026):
# - Google Gemini API: $0-5 (generous free tier available)
# - Google Search API: $0.50-1.00 (if web search enabled)
# - GitHub API: Free (within rate limits)
# - LinkedIn API: Varies (if approved)

# Tips to reduce costs:
# - Use gemini-3.5-flash (great performance, reasonable cost)
# - Use gemini-3.1-flash-lite for maximum savings
# - Limit web search results
# - Process candidates in smaller batches
# - Cache results to avoid reprocessing
